# Copy to remapper.env, fill in the key, then: chmod 600 remapper.env
# Never commit the real file (it holds the admin API key).
TS6_API_KEY=put-the-admin-api-key-here
TS6_QUERY_URL=http://127.0.0.1:10080/1
LEGACY_DB=/opt/teamspeak6/remapper/legacy.sqlite
STATE_DB=/opt/teamspeak6/remapper/state.sqlite
TS6_DB=/opt/teamspeak6/data/tsserver.sqlitedb
AVATAR_DIR=/opt/teamspeak6/data/files/virtualserver_1/internal
DST_SERVER=1
POLL_SECONDS=3
